{
  "extends": ["config:base"],
  "dependencyDashboard": true,
  "repositories": [
    "msolanik/Geliosphere"
  ],
  "dependencyDashboardAutoclose": true,
  "prConcurrentLimit": 1,
  "ignorePaths": [
    "Visualization/**",
    "ModelDocs/**"
  ],
  "packageRules": [
    {
      "groupName": "Docker and CMake dependencies",
      "matchManagers": ["regex", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "assignees": ["msolanik"]
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["CMakeLists\\.txt"],
      "matchStrings": [
        "GIT_REPOSITORY\\s+https://github.com/(?<depName>[^/\\s]+/[^/.\\s]+)(?:\\.git)?[\\s\\S]*?GIT_TAG\\s+(?<currentValue>[\\w\\.\\-]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}